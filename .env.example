# Required for deep-dive generation (the level-matched, web-search-grounded
# explainers), applied insights, and News for any interest without a
# curated RSS/API source (custom interests, Business, Political Science).
# Curated News still works without it.
ANTHROPIC_API_KEY=

# Optional. Model used for content needing real judgment (Deep Dive
# writing, Steelman, explain-it-back feedback) — see the README's Cost
# optimization section for the full per-content-type tier map.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Model used for compression/extraction/light structured tasks
# (News summaries, Applied Insight, Drills, Mental Model lens, the
# search-and-gather step of any web-search call).
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5

# --- Hosted deployment only (leave both unset for local dev — the app uses
# a local SQLite file at ./data/neuro-digest.db instead) ---
# A Turso (libSQL) database URL and auth token. Create one at turso.tech,
# or via the CLI: `turso db create digest && turso db show digest --url`
# and `turso db tokens create digest`. See the README's deployment section.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Hosted deployment only (leave unset for local dev) ---
# A shared passphrase that gates the whole app behind a login page, so a
# public URL can't be used by strangers to spend your Anthropic API budget.
# Pick your own value; there's no separate signup.
SITE_PASSWORD=

# --- Optional: News summaries via any OpenAI-compatible provider ---
# When SUMMARY_LLM_API_KEY is set, News summaries (and Neuroscience
# classification) use this instead of Anthropic — e.g. Groq's free tier.
# Items are sent one per request, paced by the provider's rate-limit headers.
# To use OpenRouter instead: BASE_URL=https://openrouter.ai/api/v1 and a
# model such as nvidia/nemotron-3-super-120b-a12b:free (free tier is slow and
# capped at ~50 requests/day without credits).
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=https://api.groq.com/openai/v1
SUMMARY_LLM_MODEL=openai/gpt-oss-120b
