# Copy to .env.local for local development. Set the same names in your
# hosting dashboard for production. Never commit real values.

# --- AI (paid: Claude) ---
# Used for the shared content pool and for Pro accounts, with web search and
# half-price batch writing. With OPENROUTER_API_KEY also set (below), free
# accounts' personal requests go to free models instead. With neither key the
# app still runs, but no new content is written.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults shown.
# ANTHROPIC_MODEL=claude-sonnet-5-5        # deep dives, web-searched roundups
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5    # summaries, research gathering, bite splitting, quizzes, Q&A
#                                          # (ANTHROPIC_MODEL_HAIKU is accepted as an alias)
# ANTHROPIC_MODEL_DEEP=claude-opus-5-5     # research-level deep dives

# --- News summaries via any OpenAI-compatible provider (optional) ---
# When SUMMARY_LLM_API_KEY is set, news summaries (and Neuroscience
# classification) use this provider instead of Anthropic, e.g. the Groq free
# tier. Items are sent one per request, paced by the rate-limit headers; a
# guard rejects summaries containing numbers that are not in the source.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=https://api.groq.com/openai/v1
SUMMARY_LLM_MODEL=openai/gpt-oss-120b
# How long one summarization run may take, in ms (defaults to 30000 on Vercel).
# SUMMARY_TIME_BUDGET_MS=30000

# --- OpenRouter (optional) ---
# Powers the Research tab and free accounts' personal AI requests (asks,
# explain-backs, Library), via OpenRouter's Anthropic-compatible endpoint on
# free NVIDIA Nemotron models by default. If ANTHROPIC_API_KEY is empty it
# runs ALL generation, with no web search (deep dives written from model
# knowledge, no sources) and no Batch API.
OPENROUTER_API_KEY=
# Main writing model (and the Research Agent's). Default: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=
# Quick tasks (gathering, cards, quizzes). Default: nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL_FAST=
# Research-level deep dives. Default: OPENROUTER_MODEL
# OPENROUTER_MODEL_DEEP=
# A contact email for the OpenAlex polite pool (better rate limits).
OPENALEX_MAILTO=
# Raises the Semantic Scholar rate limit above the public tier.
SEMANTIC_SCHOLAR_API_KEY=

# --- Database ---
# Leave both empty to use a local SQLite file at ./data/neuro-digest.db.
# For a hosted deployment, create a Turso database and set both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 to force the local file even when the Turso values are present
# (npm run dev:local does this for you).
# NEURON_LOCAL_DB=1

# --- Accounts ---
# The account that signs up with this email becomes the admin and inherits
# any data from before accounts existed. If unset, the first account to sign
# up is the admin, so set it before deploying somewhere public.
ADMIN_EMAIL=

# --- Scheduled generation ---
# Any long random string. The scheduler calls /api/cron/tick with it as a
# Bearer token (Vercel Cron does this automatically when it is set).
CRON_SECRET=
# How long one tick may work, in ms. Keep under your function time limit.
# TICK_BUDGET_MS=45000
# Scheduler-originated deep dives are written through the half-price Message
# Batches API and published on a later tick. Set to 0 to write them live.
# BATCH_WRITES=1

# --- Push notifications (optional) ---
# Generate a pair with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can reach you at, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Billing (optional) ---
# Link to your checkout page. Until it is set, the upgrade page says Pro is
# not on sale yet. Plans are switched from the admin page.
NEXT_PUBLIC_BILLING_URL=
