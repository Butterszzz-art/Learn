# Copy to .env.local for local development. Set the same names in your
# hosting dashboard for production. Never commit real values.

# --- AI (required for generating content) ---
# Without it the app still runs: curated news, facts and anything already in
# the pool are served, but no new deep dives are written.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults shown.
# ANTHROPIC_MODEL=claude-sonnet-5-5        # deep dives, web-searched roundups
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5    # summaries, bite splitting, quizzes, feedback, Q&A
# ANTHROPIC_MODEL_DEEP=claude-opus-5-5     # research-level deep dives

# --- Database ---
# Leave both empty to use a local SQLite file at ./data/neuro-digest.db.
# For a hosted deployment, create a Turso database and set both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 to force the local file even when the Turso values are present
# (npm run dev:local does this for you).
# NEURON_LOCAL_DB=1

# --- Accounts ---
# The account that signs up with this email becomes the admin and inherits
# any data from before accounts existed. If unset, the first account to sign
# up is the admin, so set it before deploying somewhere public.
ADMIN_EMAIL=

# --- Scheduled generation ---
# Any long random string. The scheduler calls /api/cron/tick with it as a
# Bearer token (Vercel Cron does this automatically when it is set).
CRON_SECRET=
# How long one tick may work, in ms. Keep under your function time limit.
# TICK_BUDGET_MS=45000

# --- Push notifications (optional) ---
# Generate a pair with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can reach you at, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Billing (optional) ---
# Link to your checkout page. Until it is set, the upgrade page says Pro is
# not on sale yet. Plans are switched from the admin page.
NEXT_PUBLIC_BILLING_URL=
