{
  "appId": "app.neuron.learn",
  "appName": "Neuron",
  "webDir": "capacitor-shell",
  "appendUserAgent": "NeuronApp",
  "server": {
    "url": "https://learn-n6r5.vercel.app",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#120f1e",
    "scheme": "Neuron",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#120f1e",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
